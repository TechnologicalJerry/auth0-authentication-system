# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=auth0-authentication-system-express
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth0_db?schema=public

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

