# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=auth0-authentication-system-express
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth0_db?schema=public

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ALGORITHMS=RS256
AUTH0_CLOCK_TOLERANCE=5

# Auth0 (Optional - derived from AUTH0_DOMAIN if not set)
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
# AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# Auth0 (Optional - only needed for Management API in Phase 3+)
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret

# Auth0 (Optional)
# AUTH0_TOKEN_MAX_AGE=86400
# AUTH0_ROLES_CLAIM_NAMESPACE=https://your-app.example.com/roles
