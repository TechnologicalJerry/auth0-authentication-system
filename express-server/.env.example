# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=auth0-authentication-system-express
APP_VERSION=1.0.0

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://user:password@localhost:5432/auth0_db?schema=public

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ALGORITHMS=RS256
AUTH0_CLOCK_TOLERANCE=5

# Auth0 (Optional - derived from AUTH0_DOMAIN if not set)
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
# AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_TOKEN_MAX_AGE=86400
# AUTH0_ROLES_CLAIM_NAMESPACE=https://your-app.example.com/roles

# Redis (Redis 8)
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=5
REDIS_KEY_PREFIX=auth0_app:

# Distributed Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_ADMIN_MAX_REQUESTS=60

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
TRUST_PROXY=loopback, linklocal, uniquelocal

# Swagger / OpenAPI Documentation
SWAGGER_ENABLED=true

# Authorization Cache TTL (seconds)
AUTH_CACHE_TTL_SECONDS=300

# Server Lifecycle & Shutdown Timeout (ms)
SHUTDOWN_TIMEOUT_MS=10000
