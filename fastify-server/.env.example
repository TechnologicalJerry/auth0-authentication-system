# Application Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=fastify-server
LOG_LEVEL=info

# PostgreSQL 18 Connection
DATABASE_URL=postgresql://auth_user:auth_secure_password_2026@localhost:5432/auth0_auth_db?schema=public

# Auth0 Identity Provider Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.auth0-system.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
AUTH0_ALGORITHMS=RS256
AUTH0_CLOCK_TOLERANCE=5
AUTH0_ROLES_CLAIM_NAMESPACE=https://api.auth0-system.com/roles

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
TRUST_PROXY=false
