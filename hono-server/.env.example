# Server Environment Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=hono-server
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth0_auth_system?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY=true

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
TRUST_PROXY=false

# Auth0 Configuration
AUTH0_DOMAIN=dev-example.us.auth0.com
AUTH0_AUDIENCE=https://api.auth0-auth-system.local
AUTH0_ISSUER_BASE_URL=https://dev-example.us.auth0.com/
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_ALGORITHMS=RS256
AUTH0_JWKS_URI=https://dev-example.us.auth0.com/.well-known/jwks.json
AUTH0_CLOCK_TOLERANCE=5
AUTH0_TOKEN_MAX_AGE=86400
AUTH0_ROLES_CLAIM_NAMESPACE=https://api.auth0-auth-system.local/roles

